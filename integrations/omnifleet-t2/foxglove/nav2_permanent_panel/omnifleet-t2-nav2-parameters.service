[Unit]
Description=OmniFleet T2 permanent Nav2 parameters
After=network-online.target

[Service]
Type=simple
User=iecme
Group=iecme
WorkingDirectory=/home/iecme/workspace/omnifleet_t2_ws
EnvironmentFile=/etc/omnifleet_t2/robot.env
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && source /home/iecme/workspace/hardware_drivers_ws/install/setup.bash && source /home/iecme/workspace/mola_3_2_ws/install/setup.bash && source /home/iecme/workspace/omnifleet_t2_ws/install/setup.bash && exec python3 /home/iecme/workspace/omnifleet_t2_ws/foxglove/nav2_permanent_panel/nav2_parameter_store.py'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
