[Unit]
Description=104 Android color shape QR and AprilTag detection
After=omnifleet-t2-rgbd-camera.service
[Service]
User=iecme
Environment=HOME=/home/iecme
Environment=ROS_DOMAIN_ID=104
ExecStart=/bin/bash -lc 'source /home/iecme/omnifleet_ws/env.bash; exec python3 /opt/omnifleet-mobile-vision/mobile_vision.py'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
[Install]
WantedBy=multi-user.target
