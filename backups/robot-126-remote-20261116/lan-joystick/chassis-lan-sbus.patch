+    def on_lan_channels(self, message):
+        data = message.data
+        if len(data) != 17:
+            return
+        stamp = data[0]
+        age_ns = time.monotonic_ns() - stamp
+        if stamp <= self._lan_stamp_ns or not 0 <= age_ns < 350_000_000:
+            return
+        if not all(800 <= data[i + 1] <= 2200 for i in (0, 2, 4)):
+            return
